# Use this file with
# `source ~/main.syncthing/monochrome/module/email/neomuttrc`.

# Utility.
set my_active_dir="~/main.syncthing/monochrome/module/email/"
set my_archive_dir="~/main.syncthing/monochrome/archive.syncthing/module/email/"
# Change to `snowfall` for <save-entry>.
cd ~/main.syncthing/snowfall/

# Receive.
set spool_file=\
	"~/main.syncthing/monochrome/machine/gilgamesh-58/inbox.maildir/"
# Sent emails and processed emails are "deleted" into an
# "archive". Messages from $postponed should only be purged.
# Messages deleted from the "archive" are "purged".
set record="${my_archive_dir}archive.maildir/"
set postponed="${my_active_dir}postponed.maildir/"
set trash="$record"
# Helps with Windows syncing.
set maildir_field_delimiter=";"
named-mailboxes inbox $spool_file
named-mailboxes -nonotify postponed $postponed \
	archive $trash
# Unfortunately this sets for both the file/folder browser.
set browser_sort=unsorted

# Receive: Gmail IMAP.
# "delete" messages = "archive". Use `xb` for real delete,
# along with `xi`, `xa`.
# Allow access to IMAP folder if necessary.
set imap_user="yangawesome@gmail.com"
set imap_authenticators="oauthbearer:xoauth2"
set imap_oauth_refresh_command=\
	"/usr/share/neomutt/oauth2/mutt_oauth2.py \
	${my_active_dir}yangawesome_gmail.com.password.token \
	--decryption-pipe cat --encryption-pipe cat"
# For convenience to navigate to other folders.
set folder="imaps://imap.gmail.com"
# General IMAP hygiene.
set mail_check=300
set timeout=300

# Send: via `gilgamesh.cc` usually.
unset ssl_force_tls
set real_name="Yang Yan"
set from="yang@gilgamesh.cc"
set signature="${my_active_dir}.signature"
set fast_reply=yes
# Reply from receiving mailbox, if on this list.
set reverse_name
# Not all SMTP servers are set up yet: `yangilga@outlook.com
# gilgamesh@tfwno.gf gilgameshxzero@icloud.com
# gilgameshxzero@outlook.com`.
alternates @gilgamesh.cc ^yangawesome@gmail.com$ \
	^yangilga@mit.edu$ ^yyan99@mit.edu$
# This file automatically sources the relevant passwords.
source "${my_active_dir}neomuttrc.password"
# Adjust SMTP server based on sending address.
# For some reason, AUTH LOGIN on SMTP is not explicitly
# selectable, so `smtp_authenticators` needs to be set for
# each hook.
set smtp_oauth_refresh_command="$imap_oauth_refresh_command"
set my_smtp_url_gilgamesh_cc="smtp://yang@gilgamesh.cc:2525"
set my_smtp_url_yangawesome_gmail_com=\
	"smtp://yangawesome@gmail.com@smtp.gmail.com:587"
set my_smtp_url_mit_edu=\
	"smtp://yangilga@outgoing.mit.edu:587"
# `send2-hook` is used because it is run each time the
# message is edited, including when `From:` is edited.
send2-hook "~f @gilgamesh\.cc$" "set \
	smtp_url='$my_smtp_url_gilgamesh_cc' \
	smtp_authenticators='' \
	smtp_pass='$my_smtp_pass_gilgamesh_cc'"
send2-hook "~f ^yangawesome@gmail\.com$" "set \
	smtp_url='$my_smtp_url_yangawesome_gmail_com' \
	smtp_authenticators='$imap_authenticators' \
	smtp_pass=''"
send2-hook "~f @mit\.edu$" "set \
	smtp_url='$my_smtp_url_mit_edu' \
	smtp_authenticators='' \
	smtp_pass='$my_smtp_pass_mit_edu'"
# Always quote reply.
set include=yes
# Don't include hostname in message ID.
set message_id_format="<%z@gilgamesh.cc>"
# `khard` handles address book queries.
set query_command="echo %s | \
	xargs khard email -d formatted_name --parsable --"
# Don't ask for confirmation for delete.
set delete=yes

# View: general and index options.
set header_cache="~/.neomutt/cache/"
set message_cache_dir="~/.neomutt/cache/"
set pager_stop=yes
set sort=reverse-date
set sort_aux=reverse-last-date-received
set use_threads=no
set time_inc=1000
set attach_format="%T %s %<f?%f&%m/%M>"
# Use `t` to tag to attach multiple.
set folder_format="%t %f"
# Display message size, not number of lines, in index.
set index_format="%4C %Z %{%b %d} %-15.15L %4cr %s"
# Don't display line wrap markers for easy copy.
set markers=no
# Don't ask for confirmation on some functions.
set wait_key=no
# Dump with `mailcap` if html available and no plaintext.
set mailcap_path="${my_active_dir}mailcap"
auto_view text/html
alternative_order text/plain text/html

# Force color for older patches.
color normal default default
color hdrdefault default default
color signature default default
color quoted0 default default
color tilde default default
color bold bold default default
color attachment bold default default
color status bold reverse default default
color indicator reverse default default
color tree default default

# Search, reply, tab complete.
bind editor <Tab> complete-query
bind editor ^T complete
# Group reply by default.
bind index,pager R group-reply
# Swap N, Ctrl+N.
bind index,pager N search-opposite
bind index \CN toggle-new
# Editor scroll is confusing to me.
bind editor <space> noop
# Ignore deleted messages in up/down. Up/down usually
# switches messages, except in the pager, where left/right
# accomplishes the same.
bind index,pager K previous-unread
bind index,pager J next-unread
bind index <Up> previous-entry
bind index <Down> next-entry
bind pager <Left> previous-entry
bind pager <Right> next-entry
bind pager <Up> previous-line
bind pager <Down> next-line
# Alt+E/R scroll bindings.
bind index,pager <Esc>e previous-page
bind index,pager <Esc>r next-page

# Keybind `x`-keys are general operations.
bind index,pager x noop
macro index,pager xi \
	"<save-message>$spoolfile<enter><enter>" \
	"Move message to INBOX."
macro index,pager xp "<purge-message>" "Purge message.
macro index,pager xr \
	"<tag-pattern>~U<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" \
	"Mark all as read."
macro index,pager xc \
	"<search>~m<space><1024<space>~B<space>17a7ceae-5204-47cd-8c8a-74b95b3aa83d<enter>" \
	"Cache messages."
# Toggle Gmail IMAP folders.
# Open/close IMAP folders. This may leave an IMAP
# connection even after close, which might slow down all
# `neomutt` operations until restart.
macro index,pager xgo "<enter-command>mailboxes \
	-nonotify -nopoll \
	=INBOX \
 	'=[Gmail]/Sent Mail' =[Gmail]/Drafts '=[Gmail]/All Mail' \
	=[Gmail]/Spam =[Gmail]/Bin \
	=[Gmail]/Chats =[Gmail]/Important \
	=[Gmail]/Starred<enter>" \
	"Open IMAP mailboxes."
macro index,pager xgc "<enter-command>unmailboxes \
	=INBOX \
 	'=[Gmail]/Sent Mail' =[Gmail]/Drafts '=[Gmail]/All Mail' \
	=[Gmail]/Spam =[Gmail]/Bin \
	=[Gmail]/Chats =[Gmail]/Important \
	=[Gmail]/Starred<enter>" \
	"Close IMAP mailboxes."
