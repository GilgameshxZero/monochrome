# Loaded by `neomuttrc`. Relative to `$/snowfall`.
audio/*; xdg-open %s
image/*; xdg-open %s
video/*; xdg-open %s
text/html; ~/main.syncthing/monochrome/module/email/neomutt-html-open.sh %s
text/html; lynx -dump -hiddenlinks=ignore %s; copiousoutput; nametemplate=%s.html
text/calendar; ~/main.syncthing/monochrome/module/email/mutt-ical.py -D %s; copiousoutput
text/x-vcalendar; ~/main.syncthing/monochrome/module/email/mutt-ical.py -D %s; copiousoutput
application/ics; ~/main.syncthing/monochrome/module/email/mutt-ical.py -D %s; copiousoutput
application/octet-stream; mpv %s
application/*; xdg-open %s
