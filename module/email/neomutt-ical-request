#!/usr/bin/env bash
set -euo pipefail
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
if [[ $OSTYPE == msys* || $OSTYPE == cygwin* ]]; then
    uuidgen() { powershell.exe -NoLogo -NoProfile -NonInteractive -Command '([guid]::NewGuid()).ToString()' | tr -d '\r'; }
fi
# Remove a NeoMutt-owned placeholder if generation fails or is cancelled.
trap 'status=$?; if (( status != 0 )); then rm -f .request.tmp.ics; fi' EXIT

# Read the current message rather than a From value captured at config load.
# Source-tree and installed bundles share the same Python implementation.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ical_helper="$script_dir/mutt-ical.py"
[[ -f $ical_helper ]] || ical_helper="$script_dir/../python/mutt-ical.py"
draft=${1:-}
subject=
to=
if [[ -n $draft && -f $draft ]]; then
    {
        IFS= read -r -d '' subject
        IFS= read -r -d '' to
        IFS= read -r -d '' NEOMUTT_FROM
    } < <(python3 -X utf8 "$ical_helper" --draft-headers "$draft")
    rm -f "$draft"
else
    : "${NEOMUTT_FROM:?NEOMUTT_FROM is not set}"
    NEOMUTT_FROM=$(python3 -X utf8 "$ical_helper" --mailbox-address "$NEOMUTT_FROM")
fi

if [[ -n $subject ]]; then
	read -rp "Subject [$subject]: " input
	subject=${input:-$subject}
else
	read -rp "Subject: " subject
fi

if [[ -z $to ]]; then
	read -rp "To: " to
fi

read -rp "Start (YYYY-MM-DD HH:MM): " start
read -rp "Duration (e.g. 45m, 1h, 1h30m): " duration

# Interpret the supplied start time as local time and convert to UTC.
start_utc=$(date -d "$start" -u '+%Y%m%dT%H%M%SZ')
dtstamp=$(date -u '+%Y%m%dT%H%M%SZ')
uid="$(uuidgen)@$(hostname -f 2>/dev/null || hostname)"

# Convert the duration to an RFC 5545 DURATION value.
if [[ $duration =~ ^([0-9]+)h([0-9]+)m$ ]]; then
	duration_ics="PT${BASH_REMATCH[1]}H${BASH_REMATCH[2]}M"
elif [[ $duration =~ ^([0-9]+)h$ ]]; then
	duration_ics="PT${BASH_REMATCH[1]}H"
elif [[ $duration =~ ^([0-9]+)m$ ]]; then
	duration_ics="PT${BASH_REMATCH[1]}M"
else
	echo "Invalid duration: $duration (use e.g. 45m, 1h, 1h30m)" >&2
	exit 1
fi

# Escape RFC 5545 text values.
escape_ics() {
	local value=$1
	value=${value//\\/\\\\}
	value=${value//;/\\;}
	value=${value//,/\\,}
	value=${value//$'\n'/\\n}
	printf '%s' "$value"
}

subject=$(escape_ics "$subject")

{
	printf '%s\n' \
		'BEGIN:VCALENDAR' \
		'VERSION:2.0' \
		'PRODID:-//Rain//Emilia//EN' \
		'METHOD:REQUEST' \
		'BEGIN:VEVENT'

	printf 'UID:%s\n' "$uid"
	printf 'DTSTAMP:%s\n' "$dtstamp"
	printf 'DTSTART:%s\n' "$start_utc"
	printf 'DURATION:%s\n' "$duration_ics"
	printf 'SUMMARY:%s\n' "$subject"
	printf 'ORGANIZER:mailto:%s\n' "$NEOMUTT_FROM"

	# The recipients may be comma- or whitespace-separated.
	tr ',[:space:]' '\n\n' <<< "$to" |
		while IFS= read -r address; do
			[[ -z "$address" ]] && continue
			printf 'ATTENDEE;RSVP=TRUE:mailto:%s\n' "$address"
		done

	printf '%s\n' \
		'SEQUENCE:0' \
		'STATUS:CONFIRMED' \
		'END:VEVENT' \
		'END:VCALENDAR'
} > .request.tmp.ics

echo "Created .request.tmp.ics"
