# Higher threads fails Youtube RSS.
reload-threads 1
cleanup-on-quit	no
confirm-mark-all-feeds-read no
confirm-mark-feed-read no

color background default default
color listnormal default default
color listfocus default default reverse
color listfocus_unread default default reverse bold
color title default default reverse bold
color info default default reverse bold
color hint-key default default reverse bold

macro c set browser clip; open-in-browser; set browser xdg-open

browser xdg-open
